#include <stdio.h>
int main(){
	int soma = 0, i;
	
	for (i=1; i<=500; i++){
	
		if (i % 2 != 0 && i % 3 == 0){
        soma = soma + i;
		}	
	}
	
	printf("Soma de todos os numeros impares que sao multiplos de 3: %d", soma);

return 0;
}


