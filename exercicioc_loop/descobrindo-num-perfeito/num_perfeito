#include <stdio.h>

int main() {
    int n, i = 1, soma = 0;

    printf("Digite um numero: ");
    scanf("%d", &n);

   if (n <= 1) {
        printf("Nao eh perfeito.\n");
    } else {
        do {
           
            if (n % i == 0) {
                soma = soma + i;
            }
            i++; 
            
        } while (i < n); 
        
        if (soma == n) {
            printf("O numero %d eh perfeito!\n", n);
        } else {
            printf("O numero %d nao eh perfeito.\n", n);
        }
    }

    return 0;
}


