#include <stdio.h>

int main() {
    float sal, salt = 0, maiorsal = 0;
    int nf, nft = 0, cont = 0, nsal100 = 0;

    printf("Digite o salario (negativo para sair): ");
    scanf("%f", &sal);

    while (sal >= 0) {
        printf("Numero de filhos: ");
        scanf("%d", &nf);

        
        salt = salt + sal; 
        nft = nft + nf;   
        cont++;           

       
        if (sal > maiorsal) {
            maiorsal = sal;
        }

        if (sal <= 100) {
            nsal100++;
        }

        printf("\nDigite o proximo salario (negativo para sair): ");
        scanf("%f", &sal);
    }

    if (cont > 0) {
        printf("\n--- RESULTADOS ---");
        printf("\nMedia salarial: R$ %.2f", salt / cont);
        printf("\nMedia de filhos: %.1f", (float)nft / cont);
        printf("\nMaior salario: R$ %.2f", maiorsal);
        printf("\nPercentual ate R$ 100: %.2f%%\n", ((float)nsal100 / cont) * 100);
    } else {
        printf("\nNenhum dado coletado.");
    }

    return 0;
}
