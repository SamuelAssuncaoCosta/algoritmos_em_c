	printf("digite a coluna da torre (1 ate 8): ");
	scanf("%d", &colunaTorre);
	
	for(i=1; i<=8; i++){
		for(j=1; j<=8; j++){
			if (i == linhaTorre && j == colunaTorre){
				printf("o");
			} else if ( i == linhaTorre || j == colunaTorre){
				printf("x");
			}else {
				printf("-");
			}
		}
		printf("\n");
	}
return 0;
}


