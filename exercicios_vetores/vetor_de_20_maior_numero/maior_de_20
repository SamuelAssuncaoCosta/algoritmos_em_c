#include <stdio.h>
int main(){
	int v[20],i,maior = 0, posicao=0;
	
	for(i=0;i<20;i++){
		printf("insira o numero: ");
		scanf("%d", &v[i]);
	}
	maior = v[0]; 
    posicao = 0;
	for(i=0;i<20;i++){
		if(v[i] > maior){
			maior = v[i];
			posicao= i;
		}
	}
	printf("maior elemento: %d ", maior);
	printf("sua posicao: %d ", posicao);
return 0;
}





