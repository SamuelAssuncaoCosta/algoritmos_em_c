#include <stdio.h>

int main(){
    float v[500], maior; 
    int i;

    for(i=0; i<500; i++){
        printf("Insira o numero: ");
        scanf("%f", &v[i]); 
        
        if(i == 0){
            maior = v[i];
        } else if(v[i] > maior){
            maior = v[i];
        }
    }

    printf("\n--- Vetor apos as divisoes ---\n");

    for(i=0; i<500; i++){
        v[i] = v[i] / maior; 
        printf("%.2f ", v[i]);
    }

    printf("\n");
    return 0;
}
