#include <stdio.h>

int main() {
    int A[10], B[10], C[20];
    int i, j;
    int k = 0; 
    int repetido;

   
    printf("Digite os 10 valores do vetor A:\n");
    for(i = 0; i < 10; i++) scanf("%d", &A[i]);
    
    printf("Digite os 10 valores do vetor B:\n");
    for(i = 0; i < 10; i++) scanf("%d", &B[i]);

   
    for(i = 0; i < 10; i++) {
        C[k] = A[i];
        k++; 
    }

    
    for(i = 0; i < 10; i++) {
        repetido = 0; 
        
        
        for(j = 0; j < k; j++) {
            if(B[i] == C[j]) {
                repetido = 1;
                break; 
            }
        }
        
        
        if(repetido == 0) {
            C[k] = B[i];
            k++;
        }
    }

    
    printf("\nVetor C (Uniao):\n");
    for(i = 0; i < k; i++) {
        printf("%d ", C[i]);
    }
    printf("\n");

    return 0;
}
