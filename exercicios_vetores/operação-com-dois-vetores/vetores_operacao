#include <stdio.h>

int main() {
    float X[10], Y[10], Z[10];
    int i;

    
    printf("Digite os 10 valores reais para X:\n");
    for(i = 0; i < 10; i++) scanf("%f", &X[i]);
    
    printf("Digite os 10 valores reais para Y:\n");
    for(i = 0; i < 10; i++) scanf("%f", &Y[i]);

    
    printf("\nVetor Z (Diferenca X - Y):\n");
    for(i = 0; i < 10; i++) {
        Z[i] = X[i] - Y[i];
        printf("%.2f ", Z[i]);
    }

   
    printf("\nVetor Z (Soma X + Y):\n");
    for(i = 0; i < 10; i++) {
        Z[i] = X[i] + Y[i];
        printf("%.2f ", Z[i]);
    }

    
    printf("\nVetor Z (Produto X * Y):\n");
    for(i = 0; i < 10; i++) {
        Z[i] = X[i] * Y[i];
        printf("%.2f ", Z[i]);
    }
    printf("\n");

    return 0;
}
