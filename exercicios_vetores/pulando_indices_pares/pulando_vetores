#include <stdio.h>

int main(){
    int k[30], i, aux;

    
    for(i=0; i<30; i++){
        scanf("%d", &k[i]);
    }

    
    for(i=0; i<30; i += 2){
        aux = k[i];       
        k[i] = k[i + 1];  
        k[i + 1] = aux;   
    }

    
    printf("Vetor apos as trocas:\n");
    for(i=0; i<30; i++){
        printf("%d ", k[i]);
    }

    return 0;
}
