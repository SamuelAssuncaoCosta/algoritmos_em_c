#include <stdio.h>
int main(){
	int v[30],i,vi[30],vp[30], cp=0, ci=0;
	
	for(i=0;i<30;i++){
		scanf("%d", &v[i]);
		if (v[i] % 2 ==0){
			vp[cp] = v[i];
			cp++;
		}else{
			vi[ci] = v[i];
			ci++;
		}
	}
	
	printf("impares: ");
	for(i=0;i<ci;i++){
		printf("%d", vi[i]);
	}
		printf("pares: ");
	for(i=0;i<cp;i++){
		printf("%d", vp[i]);
	}	
return 0;
}


